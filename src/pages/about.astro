---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SkillBadge from '../components/SkillBadge.astro';
import Tag from '../components/Tag.astro';
import { profile } from '../data/profile';
import { site } from '../data/site';

const bio = profile.bio ?? site.pages.about.description;
const avatarSrc = profile.avatar?.src;
const avatarAlt = profile.avatar?.alt ?? `${profile.name} portrait`;
const education = profile.education ?? [];
const experience = profile.experience ?? [];
const projects = profile.projects ?? [];
const skillGroups = profile.skillGroups ?? [];
const skills = profile.skills ?? [];
const certifications = profile.certifications ?? [];
---

<BaseLayout title={site.pages.about.title} description={bio}>
  <section class="site-container py-10 sm:py-14 lg:py-16">
    <div class="mx-auto flex max-w-content flex-col items-center text-center">
      {avatarSrc && (
        <figure class="card overflow-hidden p-4">
          <img
            src={avatarSrc}
            alt={avatarAlt}
            class="h-28 w-28 rounded-card object-cover sm:h-32 sm:w-32"
          />
        </figure>
      )}

      {site.pages.about.eyebrow && (
        <p class="mt-6 text-label-sm uppercase tracking-[0.08em] text-ink-subtle">
          {site.pages.about.eyebrow}
        </p>
      )}
      <h1 class="mt-3 font-heading text-display-lg-mobile font-medium tracking-tight text-balance sm:text-display-lg">
        {profile.name}
      </h1>
      {profile.title && (
        <p class="mt-3 text-body-lg text-ink-muted">
          {profile.title}
        </p>
      )}
      {bio && (
        <p class="mt-5 max-w-reading text-body-md text-ink-muted">
          {bio}
        </p>
      )}
    </div>
  </section>

  {education.length > 0 && (
    <Section title={site.pages.about.educationTitle}>
      <div class="mt-6 grid gap-4">
        {education.map((item) => (
          <article class="card-muted p-5 sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                {item.period && <p class="text-label-sm uppercase text-ink-subtle">{item.period}</p>}
                <h3 class="mt-2 font-heading text-headline-sm font-medium tracking-tight text-ink">
                  {item.title}
                </h3>
                {item.institution && <p class="mt-2 text-body-md text-ink-muted">{item.institution}</p>}
              </div>
            </div>
            {item.description && <p class="mt-4 text-body-md text-ink-muted">{item.description}</p>}
          </article>
        ))}
      </div>
    </Section>
  )}

  {experience.length > 0 && (
    <Section title={site.pages.about.experienceTitle}>
      <ol class="mt-6 space-y-4">
        {experience.map((item) => {
          const roles = item.roles ?? [];
          const singleRole = roles.length === 1 ? roles[0] : undefined;

          return (
            <li class="relative pl-14">
              <span class="absolute left-0 top-5 h-5 w-5 rounded-full border border-outline-variant bg-surface-container-lowest"></span>
              <span class="absolute left-2 top-10 h-[calc(100%-1.25rem)] w-px bg-outline-variant"></span>
              <article class="card-muted p-5 sm:p-6">
                {singleRole ? (
                  <div>
                    {(singleRole.period || singleRole.duration || item.overallPeriod || item.overallDuration) && (
                      <p class="text-label-sm uppercase text-ink-subtle">
                        {[
                          singleRole.period ?? item.overallPeriod,
                          singleRole.duration ?? item.overallDuration,
                        ]
                          .filter(Boolean)
                          .join(' · ')}
                      </p>
                    )}

                    {singleRole.title && (
                      <h3 class="mt-2 font-heading text-headline-sm font-medium tracking-tight text-ink">
                        {singleRole.title}
                      </h3>
                    )}

                    {item.company && (
                      <p class="mt-2 text-body-md text-ink-muted">
                        {item.company}
                      </p>
                    )}

                    {(item.type || item.location) && (
                      <p class="mt-1 text-body-md text-ink-muted">
                        {[item.type, item.location].filter(Boolean).join(' · ')}
                      </p>
                    )}

                    {singleRole.description && (
                      <p class="mt-4 text-body-md text-ink-muted">
                        {singleRole.description}
                      </p>
                    )}

                    {(singleRole.highlights ?? []).length > 0 && (
                      <ul class="mt-4 space-y-2.5 text-body-md text-ink-muted">
                        {(singleRole.highlights ?? []).map((point) => (
                          <li class="flex gap-3">
                            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-subtle"></span>
                            <span>{point}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {(singleRole.skills ?? []).length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-2">
                        {(singleRole.skills ?? []).map((skill) => (
                          <Tag>{skill}</Tag>
                        ))}
                      </div>
                    )}
                  </div>
                ) : (
                  <>
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        {(item.overallPeriod || item.overallDuration) && (
                          <p class="text-label-sm uppercase text-ink-subtle">
                            {[item.overallPeriod, item.overallDuration].filter(Boolean).join(' · ')}
                          </p>
                        )}

                        {item.company && (
                          <h3 class="mt-2 font-heading text-headline-sm font-medium tracking-tight text-ink">
                            {item.company}
                          </h3>
                        )}

                        {(item.type || item.location) && (
                          <p class="mt-2 text-body-md text-ink-muted">
                            {[item.type, item.location].filter(Boolean).join(' · ')}
                          </p>
                        )}
                      </div>
                    </div>

                    {roles.length > 0 && (
                      <div class="mt-5 space-y-4 border-t border-outline-variant pt-5">
                        {roles.map((role) => (
                          <section class="rounded-card border border-outline-variant bg-surface-container-lowest p-4">
                            {(role.period || role.duration) && (
                              <p class="text-label-sm uppercase text-ink-subtle">
                                {[role.period, role.duration].filter(Boolean).join(' · ')}
                              </p>
                            )}

                            {role.title && (
                              <h4 class="mt-2 font-heading text-lg font-medium tracking-tight text-ink">
                                {role.title}
                              </h4>
                            )}

                            {role.description && (
                              <p class="mt-3 text-body-md text-ink-muted">
                                {role.description}
                              </p>
                            )}

                            {(role.highlights ?? []).length > 0 && (
                              <ul class="mt-3 space-y-2 text-body-md text-ink-muted">
                                {(role.highlights ?? []).map((point) => (
                                  <li class="flex gap-3">
                                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-subtle"></span>
                                    <span>{point}</span>
                                  </li>
                                ))}
                              </ul>
                            )}

                            {(role.skills ?? []).length > 0 && (
                              <div class="mt-3 flex flex-wrap gap-2">
                                {(role.skills ?? []).map((skill) => (
                                  <Tag>{skill}</Tag>
                                ))}
                              </div>
                            )}
                          </section>
                        ))}
                      </div>
                    )}
                  </>
                )}
              </article>
            </li>
          );
        })}
      </ol>
    </Section>
  )}

  {projects.length > 0 && (
    <Section title={site.pages.about.projectsTitle}>
      <div class="mt-6 grid gap-4">
        {projects.map((project) => (
          <article class="card-muted p-5 sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="font-heading text-headline-sm font-medium tracking-tight text-ink">
                {project.githubUrl ? (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="transition-colors duration-150 hover:text-action"
                  >
                    {project.title}
                  </a>
                ) : (
                  project.title
                )}
              </h3>
            </div>

            {project.highlights.length > 0 && (
              <ul class="mt-4 space-y-2.5 text-body-md text-ink-muted">
                {project.highlights.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-subtle"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            )}

            {project.technologies.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <Tag>{tech}</Tag>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </Section>
  )}

  {(skillGroups.length > 0 || skills.length > 0) && (
    <Section title={site.pages.about.skillsTitle}>
      {skillGroups.length > 0 ? (
        <div class="mt-6 grid gap-4">
          {skillGroups.map((group) => (
            <div class="card-muted p-5 sm:p-6">
              <h3 class="text-label-sm uppercase text-ink-subtle">
                {group.category}
              </h3>
              <div class="mt-3 flex flex-wrap gap-2.5 sm:gap-3">
                {group.items.map((skill) => (
                  <SkillBadge label={skill} />
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="mt-6 flex flex-wrap gap-3">
          {skills.map((skill) => (
            <SkillBadge label={skill} />
          ))}
        </div>
      )}
    </Section>
  )}

  {certifications.length > 0 && (
    <Section title={site.pages.about.certificationsTitle}>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {certifications.map((cert) => (
          <article class="card-muted p-5 sm:p-6">
            <p class="text-label-sm uppercase text-ink-subtle">{cert.date}</p>
            <h3 class="mt-2 font-heading text-lg font-medium tracking-tight text-ink">
              {cert.url ? (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="transition-colors duration-150 hover:text-action"
                >
                  {cert.title}
                </a>
              ) : (
                cert.title
              )}
            </h3>
          </article>
        ))}
      </div>
    </Section>
  )}
</BaseLayout>
