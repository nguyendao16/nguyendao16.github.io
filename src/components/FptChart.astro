---
import Section from './Section.astro';
import FptLineChart from './FptLineChart.astro';
import { parseChartSummary } from '../utils/fpt-chart.mjs';
import result from '../../public/fpt/summary.json';

const summary = parseChartSummary(result);
const number = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
const percent = new Intl.NumberFormat('en-US', { maximumFractionDigits: 2, signDisplay: 'exceptZero' });
const date = (value: string) => new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Ho_Chi_Minh', month: '2-digit', day: '2-digit', year: 'numeric' }).format(new Date(value));
const updated = new Intl.DateTimeFormat('en-US', {
  timeZone: 'Asia/Ho_Chi_Minh', dateStyle: 'short', timeStyle: 'short',
}).format(new Date(summary.updated_at));
const tone = summary.change > 0 ? 'text-emerald-700' : summary.change < 0 ? 'text-red-700' : 'text-ink-muted';
const forecast = summary.forecast;
---

<Section
  title="FPT · Price history and forecast"
  description="The model uses continuous integration and deployment through GitHub Actions, training on Kaggle, and personally collected data."
>
  <figure
    class="mt-6"
    data-fpt-chart
    data-summary={JSON.stringify(summary)}
  >
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="font-mono text-label-sm text-ink-subtle">HOSE: FPT · 60 trading sessions</p>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
              <p class="font-heading text-headline-md font-medium tabular-nums sm:text-headline-lg">
                {number.format(summary.last_close)} <span class="text-body-md font-normal text-ink-muted">VND</span>
              </p>
              <p class:list={['text-body-md font-medium tabular-nums', tone]}>
                {summary.change > 0 ? '↑' : summary.change < 0 ? '↓' : '→'} {percent.format(summary.change_percent)}%
                <span class="ml-2 text-body-sm font-normal">{summary.change > 0 ? '+' : ''}{number.format(summary.change)} VND</span>
              </p>
            </div>
          </div>
          <div aria-live="polite" class="text-body-sm">
            <p data-fpt-pending class="text-ink-muted">No new forecast available</p>
            {forecast && (
              <p data-fpt-forecast hidden class:list={[
                'rounded-button px-3 py-2 font-medium',
                forecast.direction === 'up' ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700',
              ]}>
                {forecast.direction === 'up' ? '↗' : '↘'} {date(forecast.target_session)} · {forecast.direction === 'up' ? 'Forecast: Up' : 'Forecast: No increase'}
              </p>
            )}
          </div>
        </div>
        <div class="mt-4 grid items-center gap-6 lg:grid-cols-[minmax(0,1fr)_7rem]">
        <FptLineChart summary={summary} />
        <aside class="w-28 justify-self-end text-body-sm" aria-label="Prediction results" data-fpt-performance>
          <dl class="space-y-1">
            <div class="flex items-center justify-between gap-4">
              <dt class="text-emerald-700">Correct</dt>
              <dd class="font-medium tabular-nums text-emerald-700" data-fpt-correct>{number.format(summary.performance.correct)}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt class="text-red-700">Incorrect</dt>
              <dd class="font-medium tabular-nums text-red-700" data-fpt-incorrect>{number.format(summary.performance.incorrect)}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt class="text-ink-muted">Pending</dt>
              <dd class="font-medium tabular-nums text-ink-muted" data-fpt-pending-count>{number.format(summary.performance.pending)}</dd>
            </div>
          </dl>
        </aside>
        </div>
        <figcaption class="mt-2 text-body-sm text-ink-subtle">
          <p>Session data: <time datetime={summary.source_session}>{date(summary.source_session)}</time> · Updated: <time datetime={summary.updated_at}>{updated}</time> (Vietnam time)</p>
        </figcaption>
  </figure>
</Section>

<script>
  import { initFptChart } from '../utils/fpt-chart-client';

  document.querySelectorAll<HTMLElement>('[data-fpt-chart]').forEach((chart) => {
    initFptChart(chart);
  });
</script>
