---
import { chartGeometry, outcomeColor, outcomeLabel } from '../utils/fpt-chart.mjs';
import type { ChartSummary } from '../utils/fpt-chart.mjs';

interface Props { summary: ChartSummary }
const { summary } = Astro.props;
const geometry = chartGeometry(summary, 800, { start: 0, end: 60 });
const number = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
const shortDate = (date: string) => `${date.slice(5, 7)}/${date.slice(8, 10)}`;
---

<div class="min-w-0" data-fpt-line-chart>
  <div class="relative" data-fpt-plot>
    <svg
      viewBox="0 0 800 300" class="block h-[300px] w-full select-none"
      role="img" tabindex="0" aria-labelledby="fpt-line-title" aria-describedby="fpt-line-help"
      style="touch-action: pan-y; cursor: crosshair;"
    >
      <title id="fpt-line-title">FPT closing prices over the last 60 trading sessions</title>
      <defs>
        <linearGradient id="fpt-history-fill" x1="0" y1="1" x2="0" y2="0" gradientUnits="objectBoundingBox">
          <stop offset="0%" stop-color={geometry.color} stop-opacity=".25" />
          <stop offset="100%" stop-color="var(--color-surface)" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="fpt-forecast-fill" x1="0" y1="1" x2="0" y2="0" gradientUnits="objectBoundingBox">
          <stop offset="0%" stop-color={summary.forecast?.direction === 'up' ? '#16834a' : '#d33c43'} stop-opacity=".25" />
          <stop offset="100%" stop-color="var(--color-surface)" stop-opacity="0" />
        </linearGradient>
        <marker id="fpt-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10" fill="context-stroke" />
        </marker>
      </defs>
      <g data-fpt-grid fill="var(--color-ink-subtle)" font-size="11">
        <text x="0" y="16">VND</text>
        {geometry.prices.map((tick) => <g>
          <line x1={geometry.left} x2={geometry.right} y1={tick.y} y2={tick.y} stroke="var(--color-surface-container-high)" />
          <text x={geometry.left - 9} y={tick.y + 4} text-anchor="end">{number.format(tick.value)}</text>
        </g>)}
        {geometry.dates.map((tick, index) => <text x={tick.x} y="292" text-anchor={index === 0 ? 'start' : index === geometry.dates.length - 1 ? 'end' : 'middle'}>{shortDate(tick.date)}</text>)}
      </g>
      <path data-fpt-area d={geometry.area} fill="url(#fpt-history-fill)" />
      <path data-fpt-line d={geometry.line} fill="none" stroke={geometry.color} stroke-width="2" stroke-linejoin="round" />
      <circle data-fpt-endpoint cx={geometry.coordinates[59].x} cy={geometry.coordinates[59].y} r="3.5" fill={geometry.color} />
      <line data-fpt-divider x1={geometry.right} x2={geometry.right} y1="26" y2={geometry.bottom} stroke="var(--color-outline-variant)" stroke-dasharray="3 5" />
      <g data-fpt-tail style="display: none;">
        <path data-fpt-tail-area fill="url(#fpt-forecast-fill)" />
        <path data-fpt-tail-line fill="none" stroke={summary.forecast?.direction === 'up' ? '#16834a' : '#d33c43'} stroke-width="2" stroke-dasharray="5 4" marker-end="url(#fpt-arrow)" />
        <text data-fpt-tail-title y="14" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">Forecast</text>
        <text data-fpt-tail-date y="29" text-anchor="middle" font-size="11" fill="var(--color-ink-subtle)">{summary.forecast ? shortDate(summary.forecast.target_session) : ''}</text>
        <text data-fpt-tail-note y="44" text-anchor="middle" font-size="11" fill="var(--color-ink-subtle)">Direction only</text>
      </g>
      <g data-fpt-markers>
        {geometry.markers.map((marker) => <g data-fpt-result={marker.status} data-date={marker.date} data-rail={marker.rail ? '' : undefined}>
          <circle cx={marker.x} cy={marker.y} r="5" fill={outcomeColor(marker.status)} stroke="var(--color-surface)" stroke-width="2" />
          <title>{marker.date} · {outcomeLabel(marker.status)}</title>
          {marker.rail && <>
            <text x={(geometry.right + geometry.endX) / 2} y="14" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">Pending</text>
            <text x={(geometry.right + geometry.endX) / 2} y="29" text-anchor="middle" font-size="11" fill="var(--color-ink-subtle)">{shortDate(marker.date)}</text>
          </>}
        </g>)}
      </g>
      <g data-fpt-crosshair style="display: none;" pointer-events="none">
        <line y1="30" y2={geometry.bottom} stroke="var(--color-outline)" stroke-dasharray="3 4" />
        <circle r="4" fill={geometry.color} stroke="var(--color-surface)" stroke-width="2" />
      </g>
    </svg>
    <output data-fpt-tooltip hidden class="pointer-events-none absolute top-9 z-10 w-max max-w-full rounded-button border border-border bg-white px-3 py-2 text-body-sm text-ink shadow-soft" aria-live="polite"></output>
  </div>
  <p id="fpt-line-help" class="sr-only">Hover or tap to view prices. Hold Ctrl and scroll to zoom, then drag horizontally to pan. Keyboard: ←/→ to inspect each session, +/− to zoom, Home to reset.</p>
  <noscript><p class="sr-only">Enable JavaScript to view prices for individual sessions and use the chart controls.</p></noscript>
</div>

<style is:global>
  [data-fpt-result="pending"] > circle { animation: fpt-pending-pulse 2s ease-in-out infinite; }
  @keyframes fpt-pending-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .35; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-fpt-result="pending"] > circle { animation: none; }
  }
</style>
